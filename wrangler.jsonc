{
  // PaintersMax: static site plus /api/* backend on one Cloudflare Worker.
  "name": "paintersmax-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Needed by the PDF library (Browser Rendering).
  "compatibility_flags": ["nodejs_compat"],
  // Headless browser used to turn documents into real PDFs. Needs the Workers Paid plan.
  "browser": { "binding": "BROWSER" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/q/*", "/quote", "/sign/*", "/coi/*", "/portal/*", "/login", "/dashboard", "/app", "/jobs", "/insurance", "/materials", "/admin", "/start"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paintersmax-db",
      "database_id": "8b4e1193-87f2-4c81-a936-0f5f9d07ab79",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FROM_EMAIL": "PaintersMax <leads@mail.paintersmax.app>",
    // Change model names here if a provider retires or renames one.
    "MODEL_ANTHROPIC": "claude-sonnet-5-5",
    "MODEL_OPENAI": "gpt-4.1-mini",
    "MODEL_GEMINI": "gemini-2.5-flash"
  },
  // Keep variables and secrets added in the Cloudflare dashboard (like NOTIFY_EMAIL) when we deploy from GitHub.
  "keep_vars": true,
  // Every 5 minutes: email one chat summary per conversation that has gone quiet.
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
